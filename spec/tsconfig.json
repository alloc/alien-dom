{
  "include": ["./", "../src/env.d.ts"],
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "alien-dom/jsx-dom",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "outDir": "../dist",
    "target": "esnext",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "baseUrl": "../src",
    "types": []
  }
}
